{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LexingtonStanley/lugarn-comms/main/schema/common.v1.schema.json",
  "title": "lugarn-comms protocol v1: shared definitions",
  "description": "Identifiers, enums and records shared by the team spec, the app ops and the MCP tools. docs/protocol.md is the prose for every definition here.",
  "$defs": {
    "Ulid": {
      "description": "A ULID in Crockford base32, 26 characters, upper case. Generated by the broker for messages, members it spawns, turns, launches and requests.",
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "OpaqueId": {
      "description": "A stable opaque id. Team ids and the ids of members in a spec are chosen by the app; broker-made ids are ULIDs, which also match.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "TeamName": {
      "description": "The team's name: shown in the provenance header and used to name Herdr workspaces, agents and worktrees. Unique on the host.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "MemberName": {
      "description": "What agents address. Unique among a team's live members. `human` is the person.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "AgentName": {
      "description": "A member name that an agent may carry: any MemberName except the reserved `human` and `all`.",
      "allOf": [
        {
          "$ref": "#/$defs/MemberName"
        },
        {
          "not": {
            "enum": [
              "human",
              "all"
            ]
          }
        }
      ]
    },
    "Timestamp": {
      "description": "RFC 3339 in UTC with milliseconds, e.g. 2026-10-26T14:03:07.123Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "Cursor": {
      "description": "An opaque position in the host's event log. Clients store and return it; they never parse or compare it.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "Text": {
      "description": "Message, brief or task text: 1 to 65536 Unicode code points.",
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "Path": {
      "description": "An absolute path on the host, in the host's own syntax.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "SessionId": {
      "description": "A harness session id: Claude session UUID (chosen by the broker), Codex thread UUID and OpenCode ses_ id (both reported by the harness), or whatever pi uses once C0 settles it.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "UuidSessionId": {
      "description": "Claude session ids and Codex thread ids.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "OpenCodeSessionId": {
      "description": "OpenCode session ids. OpenCode reports them (\"sessionID\" in the first `opencode run --format json` event); the broker never chooses one.",
      "type": "string",
      "pattern": "^ses_[0-9A-Za-z]{8,64}$"
    },
    "Harness": {
      "type": "string",
      "enum": [
        "claude",
        "codex",
        "opencode",
        "pi"
      ]
    },
    "Profile": {
      "type": "string",
      "enum": [
        "read-only",
        "workspace",
        "bypass"
      ]
    },
    "Mode": {
      "type": "string",
      "enum": [
        "headless",
        "pane"
      ]
    },
    "Driver": {
      "type": "string",
      "enum": [
        "headless",
        "pane",
        "none"
      ]
    },
    "Pattern": {
      "type": "string",
      "enum": [
        "orchestrator",
        "manager_workers",
        "writer_reviewer",
        "pipeline",
        "custom"
      ]
    },
    "Role": {
      "type": "string",
      "enum": [
        "orchestrator",
        "manager",
        "worker",
        "writer",
        "reviewer",
        "stage",
        "custom"
      ]
    },
    "GridCapability": {
      "type": "string",
      "enum": [
        "message",
        "wake"
      ]
    },
    "MemberKind": {
      "type": "string",
      "enum": [
        "agent",
        "human"
      ]
    },
    "MemberOrigin": {
      "type": "string",
      "enum": [
        "spec",
        "spawn",
        "implicit"
      ]
    },
    "MemberState": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "stopping",
        "stopped"
      ]
    },
    "StopReason": {
      "type": "string",
      "enum": [
        "person",
        "spawner",
        "team_stopped",
        "exited",
        "died",
        "launch_failed"
      ]
    },
    "RemovedReason": {
      "type": "string",
      "enum": [
        "removed_from_spec",
        "new_run"
      ]
    },
    "Activity": {
      "type": "string",
      "enum": [
        "idle",
        "working",
        "blocked",
        "done",
        "unknown"
      ]
    },
    "SessionSource": {
      "type": "string",
      "enum": [
        "assigned",
        "reported",
        "pointer"
      ]
    },
    "TeamState": {
      "type": "string",
      "enum": [
        "stopped",
        "starting",
        "running",
        "stopping"
      ]
    },
    "RunnerState": {
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    },
    "MessageKind": {
      "type": "string",
      "enum": [
        "message",
        "reply",
        "auto_reply",
        "task"
      ]
    },
    "DeliveryState": {
      "type": "string",
      "enum": [
        "queued",
        "delivering",
        "delivered",
        "held",
        "uncertain",
        "denied",
        "expired"
      ]
    },
    "DeliveryReason": {
      "description": "Why a delivery is held, uncertain, denied or expired. See docs/protocol.md for which reasons belong to which state.",
      "type": "string",
      "enum": [
        "recipient_blocked",
        "recipient_unknown",
        "person_control",
        "budget",
        "rounds",
        "delivery_failed",
        "no_activity",
        "runner_restart",
        "turn_cancelled",
        "grid",
        "team_stopped",
        "cancelled"
      ]
    },
    "DeliveryVia": {
      "type": "string",
      "enum": [
        "pane",
        "headless",
        "human"
      ]
    },
    "TurnStatus": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "lost"
      ]
    },
    "RequestKind": {
      "type": "string",
      "enum": [
        "open-terminal",
        "return-headless",
        "stop-member",
        "spawn"
      ]
    },
    "RequestStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed"
      ]
    },
    "LeaseCause": {
      "type": "string",
      "enum": [
        "start",
        "wake",
        "open_terminal",
        "return_headless",
        "pane_exit",
        "stop",
        "died"
      ]
    },
    "LaunchEndReason": {
      "type": "string",
      "enum": [
        "converted",
        "stopped",
        "died"
      ]
    },
    "BudgetKind": {
      "type": "string",
      "enum": [
        "hops",
        "rounds"
      ]
    },
    "BudgetCause": {
      "type": "string",
      "enum": [
        "used",
        "exhausted",
        "continued",
        "reset"
      ]
    },
    "PolicyAction": {
      "type": "string",
      "enum": [
        "message",
        "spawn",
        "stop"
      ]
    },
    "SpawnFolder": {
      "type": "string",
      "enum": [
        "worktree",
        "shared"
      ]
    },
    "SpawnCap": {
      "type": "string",
      "enum": [
        "running_at_once",
        "per_run",
        "team_size"
      ]
    },
    "InboxDirection": {
      "type": "string",
      "enum": [
        "in",
        "out",
        "both"
      ]
    },
    "ResolveAction": {
      "type": "string",
      "enum": [
        "resend",
        "mark_delivered",
        "cancel"
      ]
    },
    "WarningCode": {
      "type": "string",
      "enum": [
        "folder_missing",
        "folder_not_git",
        "harness_unavailable",
        "next_launch"
      ]
    },
    "HostOS": {
      "type": "string",
      "enum": [
        "linux",
        "darwin",
        "windows"
      ]
    },
    "HostArch": {
      "type": "string",
      "enum": [
        "amd64",
        "arm64"
      ]
    },
    "HarnessIssue": {
      "type": "string",
      "enum": [
        "not_installed",
        "unsupported_version",
        "shim_only"
      ]
    },
    "AuthFailure": {
      "type": "string",
      "enum": [
        "no_token",
        "bad_token",
        "revoked"
      ]
    },
    "Face": {
      "type": "string",
      "enum": [
        "mcp",
        "cli"
      ]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "team.applied",
        "team.state_changed",
        "runner.state_changed",
        "member.added",
        "member.state_changed",
        "member.activity_changed",
        "member.session_added",
        "member.removed",
        "lease.changed",
        "message.created",
        "delivery.changed",
        "turn.started",
        "turn.finished",
        "policy.denied",
        "budget.changed",
        "rounds.changed",
        "request.changed",
        "auth.rejected",
        "worktree.removed"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "internal",
        "invalid_request",
        "unauthenticated",
        "unsupported_version",
        "not_found",
        "unknown_member",
        "denied",
        "spawn_disabled",
        "spawn_cap_reached",
        "harness_not_allowed",
        "profile_too_high",
        "nesting_not_allowed",
        "name_taken",
        "team_not_running",
        "team_running",
        "runner_unavailable",
        "herdr_unavailable",
        "harness_unavailable",
        "launch_failed",
        "lease_conflict",
        "revision_conflict",
        "cursor_invalid",
        "timeout"
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false
    },
    "MemberRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "name": {
          "$ref": "#/$defs/MemberName"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "Worktree": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/Path"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "branch"
      ],
      "additionalProperties": false
    },
    "Lease": {
      "type": "object",
      "properties": {
        "driver": {
          "$ref": "#/$defs/Driver"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "launch": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "pane": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "driver",
        "generation",
        "launch",
        "pane"
      ],
      "additionalProperties": false
    },
    "MemberSession": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SessionId"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "$ref": "#/$defs/SessionSource"
        },
        "launch": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_seen_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "ordinal",
        "source",
        "launch",
        "first_seen_at"
      ],
      "additionalProperties": false
    },
    "HerdrPlacement": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "server",
        "workspace",
        "agent"
      ],
      "additionalProperties": false
    },
    "Member": {
      "description": "The record the app mirrors. It outlives the team stopping, the runner dying and the spawner forgetting it.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "team": {
          "$ref": "#/$defs/OpaqueId"
        },
        "name": {
          "$ref": "#/$defs/MemberName"
        },
        "kind": {
          "$ref": "#/$defs/MemberKind"
        },
        "role": {
          "oneOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "#/$defs/MemberOrigin"
        },
        "spawned_by": {
          "oneOf": [
            {
              "$ref": "#/$defs/MemberRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "harness": {
          "oneOf": [
            {
              "$ref": "#/$defs/Harness"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "oneOf": [
            {
              "$ref": "#/$defs/Profile"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "oneOf": [
            {
              "$ref": "#/$defs/Mode"
            },
            {
              "type": "null"
            }
          ]
        },
        "folder": {
          "oneOf": [
            {
              "$ref": "#/$defs/Path"
            },
            {
              "type": "null"
            }
          ]
        },
        "worktree": {
          "oneOf": [
            {
              "$ref": "#/$defs/Worktree"
            },
            {
              "type": "null"
            }
          ]
        },
        "workdir": {
          "oneOf": [
            {
              "$ref": "#/$defs/Path"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/MemberState"
        },
        "stop_reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/StopReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "activity": {
          "oneOf": [
            {
              "$ref": "#/$defs/Activity"
            },
            {
              "type": "null"
            }
          ]
        },
        "lease": {
          "oneOf": [
            {
              "$ref": "#/$defs/Lease"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_driver": {
          "oneOf": [
            {
              "$ref": "#/$defs/Mode"
            },
            {
              "type": "null"
            }
          ]
        },
        "held_until": {
          "description": "While the person holds control through the `hold` op: when the hold lapses. Null otherwise.",
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "herdr": {
          "oneOf": [
            {
              "$ref": "#/$defs/HerdrPlacement"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "oneOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemberSession"
          }
        },
        "host": {
          "type": "null",
          "description": "Reserved for the multi-machine programme. Always null in v1."
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "started_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "stopped_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "removed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "removed_reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/RemovedReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "team",
        "name",
        "kind",
        "role",
        "origin",
        "spawned_by",
        "harness",
        "profile",
        "mode",
        "folder",
        "worktree",
        "workdir",
        "state",
        "stop_reason",
        "activity",
        "lease",
        "last_driver",
        "held_until",
        "herdr",
        "session",
        "sessions",
        "host",
        "created_at",
        "started_at",
        "stopped_at",
        "removed_at",
        "removed_reason"
      ],
      "additionalProperties": false
    },
    "Delivery": {
      "type": "object",
      "properties": {
        "to": {
          "$ref": "#/$defs/MemberRef"
        },
        "state": {
          "$ref": "#/$defs/DeliveryState"
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeliveryReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "via": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeliveryVia"
            },
            {
              "type": "null"
            }
          ]
        },
        "wake": {
          "type": "boolean"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "notify": {
          "description": "Deliveries to `human` only: whether this one raises a notification (false past the per-member rate limit). Null for every other recipient.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "turn": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "delivered_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "to",
        "state",
        "reason",
        "via",
        "wake",
        "attempts",
        "notify",
        "turn",
        "updated_at",
        "delivered_at"
      ],
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Ulid"
        },
        "team": {
          "$ref": "#/$defs/OpaqueId"
        },
        "from": {
          "$ref": "#/$defs/MemberRef"
        },
        "kind": {
          "$ref": "#/$defs/MessageKind"
        },
        "broadcast": {
          "type": "boolean"
        },
        "reply_to": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "$ref": "#/$defs/Text"
        },
        "hop": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "round": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "turn": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "deliveries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Delivery"
          }
        }
      },
      "required": [
        "id",
        "team",
        "from",
        "kind",
        "broadcast",
        "reply_to",
        "text",
        "hop",
        "round",
        "turn",
        "created_at",
        "deliveries"
      ],
      "additionalProperties": false
    },
    "Usage": {
      "description": "Token use as the harness reports it. Any field the harness doesn't report is null.",
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
